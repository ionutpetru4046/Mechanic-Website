# Copy to .env and fill in values from MongoDB Atlas + a random JWT secret.
#
# MONGO_URI MUST include a database name (not just …mongodb.net/?…), e.g.:
# mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/mechanic-website?retryWrites=true&w=majority
#
# In Atlas → Database Access: give the user "Read and write" on that database
# (or readWriteAnyDatabase). Read-only users cause register to fail.

MONGO_URI=
JWT_SECRET=
PORT=5000
